{
    "name": "@x6-plugin/bpmn-export",
    "version": "1.0.0",
    "description": "AntV X6 plugin for BPMN XML import/export",
    "main": "lib/index.js",
    "module": "es/index.js",
    "types": "es/index.d.ts",
    "files": [
        "lib",
        "es",
        "dist"
    ],
    "scripts": {
        "clean": "rimraf lib es dist",
        "build": "npm run clean && npm run build:cjs && npm run build:es && npm run build:umd",
        "build:cjs": "tsc -p tsconfig.json",
        "build:es": "tsc -p tsconfig.es.json",
        "build:umd": "rollup -c",
        "test": "jest",
        "lint": "eslint src --ext .ts,.tsx",
        "prepublishOnly": "npm run build"
    },
    "keywords": [
        "antv",
        "x6",
        "plugin",
        "export",
        "xml",
        "bpmn",
        "flowable",
        "workflow",
        "diagram",
        "graph"
    ],
    "author": "Your Name",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/yourusername/x6-bpmn-export.git"
    },
    "peerDependencies": {
        "@antv/x6": ">=2.0.0"
    },
    "dependencies": {
        "@antv/x6": ">=2.0.0",
        "bpmn-moddle": "^9.0.2"
    },
    "devDependencies": {
        "@antv/x6": "^2.18.1",
        "@rollup/plugin-commonjs": "^25.0.7",
        "@rollup/plugin-node-resolve": "^15.2.3",
        "@rollup/plugin-terser": "^0.4.4",
        "@rollup/plugin-typescript": "^11.1.6",
        "@types/bpmn-moddle": "^9.0.0",
        "@types/jest": "^29.5.12",
        "@types/node": "^20.11.30",
        "@typescript-eslint/eslint-plugin": "^7.3.1",
        "@typescript-eslint/parser": "^7.3.1",
        "eslint": "^8.57.0",
        "jest": "^29.7.0",
        "jest-environment-jsdom": "29.7.0",
        "rimraf": "^5.0.5",
        "rollup": "^4.13.0",
        "ts-jest": "^29.1.2",
        "tslib": "^2.6.2",
        "typescript": "^5.4.3"
    }
}